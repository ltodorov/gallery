{
  "name": "gallery",
  "version": "1.0.0",
  "private": "true",
  "description": "A script for generating static HTML photo and video galleries",
  "homepage": "https://github.com/ltodorov/gallery#readme",
  "bugs": {
    "url": "https://github.com/ltodorov/gallery/issues"
  },
  "license": "MIT",
  "author": "Lyubomir Todorov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltodorov/gallery.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf dist public/index.html",
    "compile": "tsc",
    "build": "node dist/index.js",
    "generate": "pnpm clean && pnpm compile && pnpm build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format && pnpm coverage",
    "all": "pnpm check && pnpm generate"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "html-minifier-terser": "^7.2.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4"
}
